<?xml version="1.0" encoding="utf-8"?>
<!-- SEC-AUDIT M-4: Deny all cloud and D2D data extraction (Android 12+) -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>

