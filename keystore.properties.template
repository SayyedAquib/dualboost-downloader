# DualBoost Downloader — Release Keystore Configuration
# Copy this file to keystore.properties and fill in your values.
# DO NOT commit keystore.properties or the .jks file to version control.
#
# To generate a release keystore:
#   keytool -genkeypair -v -keystore dualboost-release.jks -keyalg RSA -keysize 4096 -validity 10000 -alias dualboost
#
# Set as environment variables for CI/CD:
RELEASE_KEYSTORE_PATH=/path/to/dualboost-release.jks
RELEASE_KEYSTORE_PASSWORD=your_keystore_password
RELEASE_KEY_ALIAS=dualboost
RELEASE_KEY_PASSWORD=your_key_password

